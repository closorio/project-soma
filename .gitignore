# dependencias y entornos
node_modules/
.venv/
__pycache__/
*.pyc
# lanzador de Minecraft
tlauncher/
# servidores: mundos, jars, librerías, copias, registros y datos de jugadores
servidor/*
!servidor/rcon.py
!servidor/*.sh
!servidor/proxy/
servidor/proxy/*
!servidor/proxy/*.sh
servidor-paper/*
!servidor-paper/*.sh
servidor-local/*
!servidor-local/*.sh
!servidor-local/*.py
!servidor-local/eula.txt
servidor-supervivencia/libraries/
servidor-supervivencia/copias/
servidor-supervivencia/logs/
servidor-supervivencia/world*/
servidor-supervivencia/*.jar
servidor-supervivencia/ops.json
servidor-supervivencia/whitelist.json
servidor-supervivencia/banned-*.json
servidor-supervivencia/usercache.json
servidor-supervivencia/.preparado
# entrenamiento pesado y modelos
entrenamiento/ejecuciones/
*.pt
*.pth
*.npz
*.onnx
*.safetensors
# secretos y registros
.env*
*.log
# hub de contexto compartido: base de datos, cursores y configuración por máquina
compartido/hub.db*
compartido/.cursor-*
compartido/local.json
.claude/settings.local.json
# vault de Obsidian (conocimiento/): solo viaja la configuración compartida, no la de ventanas ni la personal
conocimiento/.obsidian/*
!conocimiento/.obsidian/app.json
!conocimiento/.obsidian/core-plugins.json
!conocimiento/.obsidian/templates.json
conocimiento/.trash/
# memoria persistente de cada personaje (F8.0a, bot/memoria_persistente.js): estado de partida, de cada máquina
mundos/*/memoria_*.json
mundos/*/memoria_*.json.*
# ajustes de cada máquina (Makefile: -include local.mk)
local.mk
