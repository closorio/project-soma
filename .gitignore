# dependencias y entornos
node_modules/
.venv/
__pycache__/
*.pyc
# lanzador de Minecraft
tlauncher/
# servidores: mundos, jars, librerías, copias, registros y datos de jugadores
servidor/*
!servidor/rcon.py
!servidor/*.sh
!servidor/proxy/
servidor/proxy/*
!servidor/proxy/*.sh
servidor-paper/*
!servidor-paper/*.sh
servidor-local/*
!servidor-local/*.sh
!servidor-local/*.py
!servidor-local/eula.txt
servidor-creativo/*
!servidor-creativo/*.sh
!servidor-creativo/*.py
servidor-supervivencia/libraries/
servidor-supervivencia/copias/
servidor-supervivencia/logs/
servidor-supervivencia/world*/
servidor-supervivencia/*.jar
servidor-supervivencia/ops.json
servidor-supervivencia/whitelist.json
servidor-supervivencia/banned-*.json
servidor-supervivencia/usercache.json
servidor-supervivencia/.preparado
# entrenamiento pesado y modelos
entrenamiento/ejecuciones/
*.pt
*.pth
*.npz
*.onnx
*.safetensors
# secretos y registros
.env*
*.log
# hub de contexto compartido: base de datos, cursores y configuración por máquina
compartido/hub.db*
compartido/.cursor-*
compartido/local.json
.claude/settings.local.json
# vault de Obsidian (conocimiento/): solo viaja la configuración compartida, no la de ventanas ni la personal
conocimiento/.obsidian/*
!conocimiento/.obsidian/app.json
!conocimiento/.obsidian/core-plugins.json
!conocimiento/.obsidian/templates.json
conocimiento/.trash/
# memoria persistente de cada personaje (F8.0a, bot/memoria_persistente.js): estado de partida, de cada máquina
mundos/*/memoria_*.json
mundos/*/memoria_*.json.*

# estado en marcha de los personajes (modos centinela y guardaespaldas, aliados): por PC, no se comparte
mundos/*/centinela_*.json
mundos/*/guardaespaldas_*.json
mundos/*/aliados.json
mundos/*/aliados_*.json
# ajustes de cada máquina (Makefile: -include local.mk)
local.mk
local.env
# datos de cada persona por mundo (2026-11-02), como un .env: sus bots, zonas, cofres, obras, árboles y diario van en la copia «.local»
# (zonas.local.json, diario.local.md…), que bot/mundo.js y entrenamiento/mundo.py hacen del versionado si falta. El versionado queda de
# plantilla y nadie lo vuelve a escribir: así un pull no trae los del compañero ni le borra los suyos
*.local.json
*.local.md
# zonas por dueño en los mundos de un solo jugador (zonas.js: zonas_<dueño>.json): de cada persona, como los .local
mundos/*/zonas_*.json
# catálogo de estructuras local (2026-11-02): las plantillas y lo importado son de cada uno (se comparten aparte); en el repo solo la
# guía, el PDF y lo que usan las pruebas
catalogo/*
!catalogo/.gitkeep
!catalogo/LEEME.md
!catalogo/comandos_construccion.pdf
!catalogo/casita_prueba.litematic
!catalogo/pruebas/
bot/estructuras/*
!bot/estructuras/casita_prueba.json
bot/materiales/*
!bot/materiales/casita_prueba.json
!bot/materiales/granja_piedra.json
